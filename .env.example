# The example deliberately cannot start the server. Generate .env with:
# .\.venv\Scripts\python.exe scripts/bootstrap_security.py
ENV=DEV
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
BACKUP_ENCRYPTION_KEY=replace-with-an-independent-fernet-key
DATABASE_URL=sqlite:///./fees.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost
# BACKUP_DIRECTORY=C:/private/grade-school-backups
